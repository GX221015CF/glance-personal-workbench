{
  "openapi": "3.1.0",
  "info": {
    "title": "Personal Workbench SUFE API",
    "version": "1.0.0",
    "description": "Local read-only school-data adapter. GET reads local snapshots. Refresh is asynchronous. Dates and times use Asia/Shanghai. Obtain the per-process X-Desktop-Token from GET /api/desktop with the same Origin. Auth is a localhost boundary, not a multi-user authentication scheme. No query parameters. Course numbers are semester-scoped. Semester and timestamps may be null before the first sync. meta.errorCode describes the last background failure. HTTP 200 describes a successful snapshot read, including stale or disconnected states. Raw source schedule text is retained in Meeting.raw."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8182"
    }
  ],
  "security": [
    {
      "DesktopToken": []
    }
  ],
  "paths": {
    "/api/sufe/v1": {
      "get": {
        "operationId": "getSufeSnapshot",
        "summary": "Read complete local snapshot",
        "responses": {
          "200": {
            "description": "Local snapshot. Check meta.available, meta.stale and meta.needsLogin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            }
          },
          "400": {
            "description": "Query parameters and request bodies are unsupported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Local Origin and desktop token required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported GET/POST method for this route.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "http://127.0.0.1:8180",
                "http://localhost:8180"
              ]
            }
          }
        ]
      }
    },
