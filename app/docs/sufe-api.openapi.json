              }
            }
          }
        },
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "http://127.0.0.1:8180",
                "http://localhost:8180"
              ]
            }
          }
        ]
      }
    },
